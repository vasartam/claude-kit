{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context-guard.py\"", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/msk_time.py\" prompt", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context-guard.py\"", "timeout": 30},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/model-advisor.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-guard.py\"", "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-guard.py\"", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/msk_time.py\" tool", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context-guard.py\"", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/msk_time.py\" stop", "timeout": 10}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context-guard.py\"", "timeout": 60},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context-guard.py\" rewake", "timeout": 30, "asyncRewake": true}
        ]
      }
    ]
  }
}
