#!/usr/bin/env python3
"""Добавляет правило в autoMode.allow файла ~/.claude/settings.json. Запускает владелец (агенту правка
собственных прав запрещена): на Mac и Linux `~/.claude/bin/automode-add-rule <файл>` (в терминале
Claude — через `! …`), иначе `python3 <kit>/bin/automode-add-rule <файл>` (на Windows — `python`).

    automode-add-rule <файл с текстом правила> [...]

Перед записью — копия settings.json рядом (settings.json.bak-<время>), дубли не добавляются.
Своего autoMode.allow ещё нет — сначала вписываются стандартные (`claude auto-mode defaults`): свой список
заменяет стандартный целиком, без этого первое же правило молча отключило бы все стандартные.
Правило подхватит только новая или перезапущенная сессия. Каталог настроек — CLAUDE_CONFIG_DIR, если задан.
"""
import json
import os
import shutil
import subprocess
import sys
import time

CLAUDE = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.join(os.path.expanduser('~'), '.claude')
SETTINGS = os.path.join(CLAUDE, 'settings.json')


def read(path):
    with open(os.path.expanduser(path), encoding='utf-8') as f:
        return f.read()


def default_allow():
    """Стандартные правила allow из `claude auto-mode defaults`; не получилось — выход без записи."""
    exe = shutil.which('claude')
    try:
        if not exe:
            raise OSError('claude не найден в PATH')
        out = subprocess.run([exe, 'auto-mode', 'defaults'], capture_output=True, text=True,
                             encoding='utf-8', timeout=120, check=True).stdout
        rules = json.loads(out)['allow']
        if not isinstance(rules, list) or not rules:
            raise ValueError('пустой список allow')
        return rules
    except (OSError, subprocess.SubprocessError, ValueError, KeyError) as e:
        sys.exit(f'своего autoMode.allow ещё нет, а стандартные правила получить не удалось ({e}). '
                 'Без них первое правило отключит все стандартные — ничего не менял.')


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    rules = [read(p).strip() for p in sys.argv[1:]]
    exists = os.path.exists(SETTINGS)
    settings = json.loads(read(SETTINGS)) if exists else {}
    auto = settings.setdefault('autoMode', {})
    if not auto.get('allow'):
        auto['allow'] = default_allow()
        print(f'своего списка не было — вписаны стандартные правила: {len(auto["allow"])}')
    allow = auto['allow']
    new = [r for r in rules if r and r not in allow]
    if not new:
        print('все правила уже есть, ничего не менял')
        return
    backup = ''
    if exists:
        backup = f'{SETTINGS}.bak-{time.strftime("%Y%m%d-%H%M%S")}'
        shutil.copy2(SETTINGS, backup)
    allow.extend(new)
    text = json.dumps(settings, ensure_ascii=False, indent=2) + '\n'
    json.loads(text)
    with open(SETTINGS, 'w', encoding='utf-8', newline='\n') as f:
        f.write(text)
    for r in new:
        print('добавлено:', r[:100] + ('…' if len(r) > 100 else ''))
    print(f'правил в autoMode.allow: {len(allow)}' + (f'; копия: {backup}' if backup else ''))
    print('перезапусти сессию, чтобы правило подхватилось')


if __name__ == '__main__':
    main()
