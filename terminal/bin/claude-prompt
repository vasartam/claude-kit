#!/usr/bin/env python3
"""Отправить промпт агенту Claude Code в панели herdr, не задев черновик владельца.

    claude-prompt TARGET TEXT    то же, что `herdr agent prompt TARGET TEXT` (панель или имя агента):
                                 тот же вывод и код выхода

`herdr agent prompt` впечатывает текст в поле ввода и жмёт Enter. Если владелец в это время набирает
промпт и ещё не отправил его, текст утилиты дописывается в конец черновика и уходит вместе с ним
(13.10.2026: недописанный промпт владельца + `/session-extract-knowledge …` одним сообщением, и
слэш-команда не в начале уже не команда). Поэтому перед отправкой:

1. читает поле ввода с экрана панели (`herdr pane read --format ansi`); подсказка пустого поля
   («Try …») — тусклый текст, она за черновик не считается;
2. черновик есть — ждёт, пока владелец перестанет печатать (поле не меняется STABLE с), и прячет
   черновик в stash Claude Code (Ctrl+S); после отправки Claude Code возвращает его в поле сам.
   Пока идёт голосовой ввод (пробел зажат), паузы не считаются: в конце поля стоит столбик громкости
   (▁…█, меняется каждые полсекунды и в тишине), надиктованное — серым до финальной расшифровки, она
   приходит ~0,6 с после отпускания (снято с экрана 14.10.2026). Пауза в речи дольше STABLE не конец;
3. отправляет TEXT через `herdr agent prompt`. Сорвалась отправка — повторный Ctrl+S на пустом поле
   возвращает черновик.

Поле не нашлось на экране (диалог, не Claude Code) — отправляет как раньше. Агент ждёт человека
(blocked) — не прячет: herdr такой промпт всё равно отвергнет.
"""
import json
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERDR = shutil.which("herdr") or str(Path.home() / ".local" / "bin" / "herdr")
STABLE = 5.0          # сек без изменений в поле — владелец не печатает
POLL = 0.5
WAIT_MAX = 1800       # дольше ждать конца набора и диктовки не будем: прячем как есть
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07")
DIM = re.compile(r"\x1b\[2m.*?\x1b\[(?:0|22)?m")
METER = re.compile("[▁▂▃▄▅▆▇█]")                                  # столбик громкости диктовки
GREY = re.compile(r"\x1b\[38;2;(\d+);\1;\1m[^\x1b]*[^\x1b\s]")     # серый текст: расшифровка не готова


def herdr(*args, timeout=15):
    return subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=timeout)


def is_rule(plain):
    s = plain.strip()
    return len(s) >= 20 and s.count("─") >= 0.8 * len(s)


def draft(pane):
    """(текст в поле ввода, идёт ли диктовка); текст "" — поле пустое, None — поля на экране нет."""
    try:
        r = herdr("pane", "read", pane, "--source", "visible", "--format", "ansi")
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode:
        return None, False
    lines = r.stdout.splitlines()
    plain = [ANSI.sub("", l) for l in lines]
    rules = [i for i, l in enumerate(plain) if is_rule(l)]
    # Поле — между двумя соседними линейками, первая строка начинается с «❯» (или «!» в режиме bash).
    for a, b in reversed(list(zip(rules, rules[1:]))):
        if b - a > 1 and plain[a + 1].lstrip()[:1] in ("❯", "!"):
            raw = lines[a + 1:b]
            mark = plain[a + 1].lstrip()[0]
            raw[0] = raw[0][raw[0].find(mark) + 1:]  # знак поля тоже серый — не в счёт
            voice = any(METER.search(ANSI.sub("", l)) or GREY.search(l) for l in raw)
            text = "\n".join(ANSI.sub("", DIM.sub("", l)).rstrip() for l in raw).strip()
            return text, voice
    return None, False


def agent(target):
    """(панель, статус) агента: цель бывает и именем агента (claude-restart), а читать надо панель."""
    try:
        a = json.loads(herdr("agent", "get", target).stdout)["result"]["agent"]
        return a.get("pane_id") or target, a.get("agent_status") or ""
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError):
        return target, ""


def stash(pane):
    herdr("pane", "send-keys", pane, "ctrl+s")
    time.sleep(0.4)


def main():
    if len(sys.argv) != 3:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    target, text = sys.argv[1:]
    pane, st = agent(target)
    stashed = False
    cur, voice = draft(pane)
    if cur and st != "blocked":
        start = changed = time.time()
        while time.time() - start < WAIT_MAX:
            time.sleep(POLL)
            nxt, voice = draft(pane)
            if nxt != cur or voice:
                cur, changed = nxt, time.time()
            if not cur or time.time() - changed >= STABLE:
                break
        if cur:
            stash(pane)
            stashed = draft(pane) == ""
    r = subprocess.run([HERDR, "agent", "prompt", target, text], capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    if stashed and (r.returncode or '"error"' in r.stdout):
        stash(pane)  # Ctrl+S на пустом поле возвращает спрятанное
    return r.returncode


if __name__ == "__main__":
    sys.exit(main())
